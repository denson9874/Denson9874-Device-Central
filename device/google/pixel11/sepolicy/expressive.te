# ==============================================================================
# ExpressiveOS SELinux Policy Declarations
# Grants privileged domain interactions without compromising SELinux Enforcing mode
# ==============================================================================

# Allow Expressive Launcher to interact with SurfaceFlinger and WindowManager
allow priv_app surfaceflinger:binder { call transfer };
allow priv_app surfaceflinger_service:service_manager find;
allow priv_app window_service:service_manager find;
allow priv_app activity_task_service:service_manager find;
allow priv_app status_bar_service:service_manager find;

# Allow Expressive Launcher to access wallpaper graphics and cache
allow priv_app wallpaper_service:service_manager find;
allow priv_app wallpaper_file:file { read getattr open };

# Allow Expressive Hub to configure system settings securely
allow system_app settings_service:service_manager find;
allow system_app system_settings_service:service_manager find;
