From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <daryldenson0405@gmail.com>
Date: Thu, 15 Oct 2026 21:09:22 -0400
Subject: [PATCH 02/10] husky: set unofficial maintainer overlay

Evolution X displays the maintainer name on the Android Version screen in
Settings. Add an overlay pointing build_maintainer_summary to Daryl Denson
as the unofficial maintainer for Android 17.
---
 lineage_husky.mk                                         | 3 +++
 .../apps/Settings/res/values/evolution_strings.xml       | 9 +++++++++
 2 files changed, 12 insertions(+)
 create mode 100644 overlay-evolution/packages/apps/Settings/res/values/evolution_strings.xml

diff --git a/lineage_husky.mk b/lineage_husky.mk
index f24af12..6688bfd 100644
--- a/lineage_husky.mk
+++ b/lineage_husky.mk
@@ -23,6 +23,9 @@ PRODUCT_SYSTEM_NAME := generic_system_google
 TARGET_SCREEN_HEIGHT := 2992
 TARGET_SCREEN_WIDTH := 1344
 
+# Evolution X Overlays
+DEVICE_PACKAGE_OVERLAYS += $(DEVICE_PATH)/overlay-evolution
+
 PRODUCT_BUILD_PROP_OVERRIDES += \
     BuildDesc="husky-user 17 CP3A.261005.005 16271449 release-keys" \
     BuildSystemDesc=generic_system_google-user 17 CP3A.261005.005 16271449 release-keys \
diff --git a/overlay-evolution/packages/apps/Settings/res/values/evolution_strings.xml b/overlay-evolution/packages/apps/Settings/res/values/evolution_strings.xml
new file mode 100644
index 0000000..8e01ac3
--- /dev/null
+++ b/overlay-evolution/packages/apps/Settings/res/values/evolution_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2019-2026 The Evolution X Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Android version screen, build maintainer -->
+    <string name="build_maintainer_summary" translatable="false">Daryl Denson (Unofficial)</string>
+</resources>
-- 
2.43.0

