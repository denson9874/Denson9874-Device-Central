From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:23:39 +0200
Subject: [PATCH 4/6] zuma: add Restart SystemUI to the advanced reboot menu

Evolution X's power menu supports it and gs201 (cheetah) and the Pixel 11
trees list it; zuma's list left it out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 overlay/LineageSdkOverlayZuma/res/values/config.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/overlay/LineageSdkOverlayZuma/res/values/config.xml b/overlay/LineageSdkOverlayZuma/res/values/config.xml
index 01cb77fc..5cbb6e63 100644
--- a/overlay/LineageSdkOverlayZuma/res/values/config.xml
+++ b/overlay/LineageSdkOverlayZuma/res/values/config.xml
@@ -7,6 +7,7 @@
     <!-- Defines the actions shown in advanced reboot submenu -->
     <string-array name="config_restartActionsList">
         <item>restart</item>
+        <item>restart_systemui</item>
         <item>restart_recovery</item>
         <item>restart_fastboot</item>
         <item>restart_bootloader</item>
