    SPDX-License-Identifier: Apache-2.0

    Stock's SCONE entries, from product/etc/sysconfig/google.xml,
    pixel_experience_2017.xml and preinstalled-packages-pixel-carrier.xml.
    Those files are shared with packages Evolution's GMS configures differently,
    so only the SCONE lines are carried here.
-->
<config>
    <!-- Satellite emergency messaging needs location even with location off. -->
    <allow-ignore-location-settings package="com.google.android.apps.scone" attributionTag="satellite_esos" />
    <allow-in-power-save package="com.google.android.apps.scone" />
    <install-in-user-type package="com.google.android.apps.scone">
        <install-in user-type="SYSTEM" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>
</config>
