<?xml version="1.0" encoding="utf-8"?>
<!-- From stock system_ext/etc/sysconfig/preinstalled-packages-tuscany.xml -->
<config>
    <!--  Face enroll Activity (SettingsGoogleFutureFaceEnroll) -->
