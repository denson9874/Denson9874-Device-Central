# AOSP ImsStack (com.android.imsstack), in the domain stock gives it. The stock
# vendor policy lets imsmediahaldaemon use its call sockets
# (imsstack_app:fd use, imsstack_app:udp_socket), which never applied while it
# ran as platform_app.
typeattribute imsstack_app coredomain;
app_domain(imsstack_app)
net_domain(imsstack_app)

set_prop(imsstack_app, ims_prop)

allow imsstack_app {
    accessibility_service
    activity_service
    activity_task_service
    alarm_service
    audio_service
    audioserver_service
    autofill_service
    cameraserver_service
    connectivity_service
    content_capture_service
    content_service
    device_state_service
    display_service
    gpu_service
    graphicsstats_service
    hint_service
    input_method_service
    input_service
    ipsec_service
    location_service
    netstats_service
    network_management_service
    notification_service
    power_service
    radio_service
    registry_service
    sensitive_content_protection_service
    sensorservice_service
    textservices_service
    thermal_service
    virtual_device_native_service
    voiceinteraction_service
}:service_manager find;
