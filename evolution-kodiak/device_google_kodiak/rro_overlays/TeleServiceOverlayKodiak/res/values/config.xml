<resources>
    <!-- kodiak's MediaTek modem uses AOSP ImsStack, not Shannon. The stock
         vendor TeleService RRO still names com.shannon.imsservice; stock
         overrides it from product, as this overlay does. -->
    <string name="config_ims_mmtel_package" translatable="false">com.android.imsstack</string>
    <string name="config_ims_rcs_package" translatable="false">com.android.imsstack</string>

    <!-- Carrier config comes from Google's CarrierSettings
         (product/priv-app/CarrierSettings), as on stock and in LineageOS's
         Pixel 10 tree (laguna TeleServiceOverlayProductLaguna). Without this
         the framework asks AOSP's com.android.carrierconfig instead, so the
         CarrierSettings we ship is never used, and carrier IMS values (VoLTE,
         codecs, RTP and SIP timers) fall back to whatever the AOSP app has. -->
    <string name="platform_carrier_config_package" translatable="false">com.google.android.carrier</string>

    <!-- The rest of stock's product TeleService values (same as laguna's). -->
    <bool name="hac_enabled">true</bool>
    <bool name="config_support_simless_emergency_rtt">true</bool>
