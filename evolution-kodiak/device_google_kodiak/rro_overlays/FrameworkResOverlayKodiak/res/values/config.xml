<resources>
    <!-- Telephony values from stock's framework-res product RRO. Our build
         doesn't ship Google's product RROs, so these fell back to AOSP
         defaults. Taken from the Pixel 11 Pro Fold's (same malibu telephony
         stack); check them against kodiak's
         framework-res__kodiak__auto_generated_rro_product with
         `aapt2 dump resources` when convenient. -->

    <!-- PixelQualifiedNetworksService (proprietary-files.txt). It chooses
         cellular or IWLAN for IMS, which Wi-Fi calling needs. -->
    <string name="config_qualified_networks_service_package" translatable="false">com.android.qns</string>

    <!-- ImsStack reads the cell location from ServiceState, e.g. for the SIP
         P-Access-Network-Info header. Without this its ServiceState arrives
         with the location stripped. -->
    <string-array name="config_serviceStateLocationAllowedPackages" translatable="false">
        <item>com.android.phone</item>
        <item>com.android.imsstack</item>
    </string-array>

    <bool name="config_smma_notification_supported_over_ims">true</bool>
    <bool name="config_smppsim_response_via_ims">true</bool>
    <bool name="config_stk_sms_send_support">true</bool>

    <!-- From stock MessagingReadRestrictionAllowlistOverlay.apk -->
    <string-array name="config_messaging_read_restriction_allowlist" translatable="false">
        <item>com.google.android.apps.pixel.relationships</item>
        <item>com.google.android.contacts</item>
    </string-array>

    <!-- Night Light curve for this panel, from stock's framework-res product RRO. -->
    <string-array name="config_nightDisplayColorTemperatureCoefficients" translatable="false">
        <item>0.0</item>
        <item>0.0</item>
        <item>1.0</item>
        <item>-0.000000014365268757</item>
        <item>0.000255092801250106</item>
        <item>-0.064156942434907716</item>
        <item>-0.000000000910931179</item>
        <item>0.000207598323269139</item>
        <item>-0.349361641294833436</item>
    </string-array>

    <!-- Play Protect's dynamic instrumentation consumer (OdadPrebuilt), from stock's
         PixelConfigOverlayCommon; vendor/gms's copy lacks it, and empty discards events. -->
    <string name="config_dynamicInstrumentationEventConsumer" translatable="false">com.google.android.odad/com.google.android.apps.miphone.odad.hb.HummingbirdEventService</string>

    <!-- Display, from stock's framework-res product RRO. The stock vendor displayconfig
         enables evenDimmer; the framework gate is off in AOSP. -->
    <bool name="config_evenDimmerEnabled">true</bool>
    <bool name="config_refreshRateSynchronizationEnabled">true</bool>

    <!-- Ultrasonic UDFPS: no swipe gestures, 4 templates, as stock. PixelConfigOverlayCommon
         (priority 1) sets gestures to true; this overlay's priority 2 wins. -->
    <bool name="config_fingerprintSupportsGestures">false</bool>
    <integer name="config_fingerprintMaxTemplatesPerUser">4</integer>
</resources>
