#
# Pixel 11 Pro XL (kodiak), Tensor G6 (malibu).
#
# Bring-up layout: Evolution X builds system, system_ext, product, init_boot,
# vendor_boot (recovery) and the vbmeta images. The kernel, dtbo,
# vendor, vendor_dlkm and system_dlkm come from the stock factory image,
# because Google publishes no malibu vendor sources (SELinux policy, HAL
# configs). vendor/google/kodiak-images is generated by extract-images.sh;
# vendor/google/kodiak (system_ext/product blobs) by extract-files.py.
#

DEVICE_PATH := device/google/kodiak
IMAGES_PATH := vendor/google/kodiak-images

include build/make/target/board/BoardConfigMainlineCommon.mk

# Architecture (stock ro.bionic.cpu_variant)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-2a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := cortex-a55

# Platform
TARGET_BOARD_PLATFORM := malibu
TARGET_BOOTLOADER_BOARD_NAME := kodiak
TARGET_NO_BOOTLOADER := true

# Kernel: stock GKI 6.12 boot image; modules live in the stock
# vendor_kernel_boot, vendor_dlkm and system_dlkm images.
TARGET_NO_KERNEL := true
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_PREBUILT_BOOTIMAGE := $(IMAGES_PATH)/images/boot.img
BOARD_PREBUILT_DTBOIMAGE := $(IMAGES_PATH)/images/dtbo.img

# vendor_boot header and cmdline match stock CD1A.261005.003. mkbootimg's
# defaults (base 0x10000000, page size 2048, offsets) already match stock.
BOARD_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_INIT_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_INIT_ARGS += --header_version $(BOARD_INIT_BOOT_HEADER_VERSION)
BOARD_RAMDISK_USE_LZ4 := true

BOARD_KERNEL_CMDLINE += \
    spmi_smartdv.load_sequential=1 \
    regmap-goog-spmi.load_sequential=1 \
    max77779_pmic.load_sequential=1 \
    max77779_pmic_spmi.load_sequential=1 \
    max77779_pmic_pinctrl.load_sequential=1 \
    samsung_dma_heap.gcma_skip_heaps=gcma_camera_internal \
    dyndbg=\"func alloc_contig_dump_pages +p\" \
    cma_sysfs.experimental=Y \
    init_on_alloc=0 \
    init_on_free=1 \
    rcupdate.rcu_expedited=1 \
    rcu_nocbs=all \
    rcutree.enable_rcu_lazy \
    swiotlb=noforce \
    disable_dma32=on \
    rodata=on \
    sysctl.kernel.sched_pelt_multiplier=4 \
    arm64.nomops \
    aoc_core.aoc_panic_on_ssr_failure=1 \
    aoc_core.aoc_enable_gsa_boot=1 \
    ufs.async_probe=1 \
    vs_drm.async_probe=1 \
    gs_governor_dsulat.async_probe=1 \
    kasan=off \
    at24.write_timeout=100 \
    log_buf_len=1024K \
    android_arch_task_struct_size=784

BOARD_BOOTCONFIG += \
    androidboot.load_modules_parallel=performance \
    androidboot.boot_devices=3c2d0000.ufs

# Recovery: resources move into vendor_boot; the generic ramdisk lives in init_boot
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT := true
TARGET_RECOVERY_FSTAB := $(IMAGES_PATH)/proprietary/fstab.malibu
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TARGET_RECOVERY_UI_MARGIN_HEIGHT := 165
TARGET_RECOVERY_UI_LIB := \
    //hardware/google/pixel/recovery:librecovery_ui_pixel \
    libfstab

# A/B
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS += \
    boot \
    dtbo \
    init_boot \
    product \
    pvmfw \
    system \
    system_dlkm \
    system_ext \
    vbmeta \
    vbmeta_system \
    vbmeta_vendor \
    vendor \
    vendor_boot \
    vendor_dlkm

# Partitions (sizes from the stock factory image)
BOARD_FLASH_BLOCK_SIZE := 4096
BOARD_BOOTIMAGE_PARTITION_SIZE := 0x04000000
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 0x00800000
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 0x04000000
BOARD_DTBOIMG_PARTITION_SIZE := 0x01000000
BOARD_PVMFWIMAGE_PARTITION_SIZE := 0x00100000
BOARD_USERDATAIMAGE_PARTITION_SIZE := 11796480000
BOARD_USES_METADATA_PARTITION := true
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

# super_empty.img: 10 GiB super, group = super - 4 MiB
BOARD_SUPER_PARTITION_SIZE := 10737418240
BOARD_SUPER_PARTITION_GROUPS := google_dynamic_partitions
BOARD_GOOGLE_DYNAMIC_PARTITIONS_SIZE := 10733223936
BOARD_GOOGLE_DYNAMIC_PARTITIONS_PARTITION_LIST := \
    system \
    system_dlkm \
    system_ext \
    product \
    vendor \
    vendor_dlkm
# super - 500 MB
BOARD_SUPER_PARTITION_ERROR_LIMIT := 10213130240

-include vendor/lineage/config/BoardConfigReservedSize.mk

# Stock first-stage fstab mounts system_ext and product as erofs only
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
TARGET_COPY_OUT_SYSTEM_EXT := system_ext
TARGET_COPY_OUT_PRODUCT := product

# Stock prebuilt partitions
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PREBUILT_VENDORIMAGE := $(IMAGES_PATH)/images/vendor.img

BOARD_USES_VENDOR_DLKMIMAGE := true
BOARD_VENDOR_DLKMIMAGE_FILE_SYSTEM_TYPE := erofs
TARGET_COPY_OUT_VENDOR_DLKM := vendor_dlkm
BOARD_PREBUILT_VENDOR_DLKMIMAGE := $(IMAGES_PATH)/images/vendor_dlkm.img

BOARD_USES_SYSTEM_DLKMIMAGE := true
BOARD_SYSTEM_DLKMIMAGE_FILE_SYSTEM_TYPE := erofs
TARGET_COPY_OUT_SYSTEM_DLKM := system_dlkm
BOARD_PREBUILT_SYSTEM_DLKMIMAGE := $(IMAGES_PATH)/images/system_dlkm.img


# Properties
TARGET_SYSTEM_EXT_PROP += $(DEVICE_PATH)/system_ext.prop
TARGET_PRODUCT_PROP += $(DEVICE_PATH)/product.prop

# SELinux: the parts of Google's system_ext policy the stock vendor policy
# depends on (Google app/daemon domains and props). The public types let the
# system_ext mapping file connect stock vendor rules to them; see
# sepolicy/system_ext/public/apps.te and check-sepolicy.sh.
SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/system_ext/public
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/system_ext/private

# Verified boot (same chain layout as stock and LineageOS laguna)
BOARD_AVB_ENABLE := true
ifneq (,$(AVB_CUSTOM_KEY_PATH))
BOARD_AVB_ALGORITHM := $(AVB_CUSTOM_ALGORITHM)
BOARD_AVB_KEY_PATH := $(AVB_CUSTOM_KEY_PATH)
else
AVB_CUSTOM_ALGORITHM := SHA256_RSA2048
AVB_CUSTOM_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
endif

BOARD_AVB_VBMETA_SYSTEM := system system_dlkm system_ext product
BOARD_AVB_VBMETA_SYSTEM_ALGORITHM := $(AVB_CUSTOM_ALGORITHM)
BOARD_AVB_VBMETA_SYSTEM_KEY_PATH := $(AVB_CUSTOM_KEY_PATH)
BOARD_AVB_VBMETA_SYSTEM_ROLLBACK_INDEX := $(PLATFORM_SECURITY_PATCH_TIMESTAMP)
BOARD_AVB_VBMETA_SYSTEM_ROLLBACK_INDEX_LOCATION := 1

BOARD_AVB_BOOT_ALGORITHM := $(AVB_CUSTOM_ALGORITHM)
BOARD_AVB_BOOT_KEY_PATH := $(AVB_CUSTOM_KEY_PATH)
BOARD_AVB_BOOT_ROLLBACK_INDEX := $(PLATFORM_SECURITY_PATCH_TIMESTAMP)
BOARD_AVB_BOOT_ROLLBACK_INDEX_LOCATION := 2

BOARD_AVB_VBMETA_VENDOR := vendor
BOARD_AVB_VBMETA_VENDOR_ALGORITHM := $(AVB_CUSTOM_ALGORITHM)
BOARD_AVB_VBMETA_VENDOR_KEY_PATH := $(AVB_CUSTOM_KEY_PATH)
BOARD_AVB_VBMETA_VENDOR_ROLLBACK_INDEX := $(PLATFORM_SECURITY_PATCH_TIMESTAMP)
BOARD_AVB_VBMETA_VENDOR_ROLLBACK_INDEX_LOCATION := 3

BOARD_AVB_INIT_BOOT_ALGORITHM := $(AVB_CUSTOM_ALGORITHM)
BOARD_AVB_INIT_BOOT_KEY_PATH := $(AVB_CUSTOM_KEY_PATH)
BOARD_AVB_INIT_BOOT_ROLLBACK_INDEX := $(PLATFORM_SECURITY_PATCH_TIMESTAMP)
BOARD_AVB_INIT_BOOT_ROLLBACK_INDEX_LOCATION := 4

# Bring-up: verification off until the build boots and is signed with release keys
ifneq ($(WITH_AVB),true)
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
endif

# Security patch level of the stock vendor/boot images
BOOT_SECURITY_PATCH := 2026-10-05
VENDOR_SECURITY_PATCH := $(BOOT_SECURITY_PATCH)

# With verification off (--flags 3) the bootloader reads properties only from
# the top-level vbmeta, not from the chained boot/vbmeta_system images. Without
# these, KeyMint gets boot patch level 0, Google's RKP server rejects every CSR
# ("boot_patch_level 20000000"), no attestation keys are issued, and AICore
# (Gemini Nano, Magic Cue) can't fetch its models. Keep them in every build
# from now on: a lower boot patch level than the phone has booted is a KeyMint
# downgrade and makes existing keystore keys unusable.
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += \
    --prop com.android.build.boot.os_version:$(PLATFORM_VERSION_LAST_STABLE) \
    --prop com.android.build.boot.security_patch:$(BOOT_SECURITY_PATCH) \
    --prop com.android.build.system.os_version:$(PLATFORM_VERSION_LAST_STABLE) \
    --prop com.android.build.system.security_patch:$(PLATFORM_SECURITY_PATCH)

include $(IMAGES_PATH)/BoardConfigImages.mk
-include vendor/google/kodiak/BoardConfigVendor.mk
