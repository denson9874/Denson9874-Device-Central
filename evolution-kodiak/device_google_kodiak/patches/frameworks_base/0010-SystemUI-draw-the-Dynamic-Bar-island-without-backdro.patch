From 0961d891120fd4f37569d24657e7730923f4c95e Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:48:32 +0200
Subject: [PATCH] SystemUI: draw the Dynamic Bar island without backdrop blur

The island blurs what is behind it, so while it shows, the status bar
window carries a blur region. SurfaceFlinger can't hand a blurred
layer stack to the hardware composer, so every frame of the app below
is composited on the GPU (794 of 794 frames scrolling Settings on a
Pixel 7 Pro at 1440p/120 Hz, 6 of them missing a vsync; 0 and 0 with
blur off). That shows as micro-stutter when scrolling.

Use the island's solid fallback colour, as with blur disabled, and
keep window blur for the shade and dialogs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../systemui/axdynamicbar/shared/IslandContentTokens.kt      | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/axdynamicbar/shared/IslandContentTokens.kt b/packages/SystemUI/src/com/android/systemui/axdynamicbar/shared/IslandContentTokens.kt
index 65a71b7271..a8da45900d 100644
--- a/packages/SystemUI/src/com/android/systemui/axdynamicbar/shared/IslandContentTokens.kt
+++ b/packages/SystemUI/src/com/android/systemui/axdynamicbar/shared/IslandContentTokens.kt
@@ -177,7 +177,10 @@ internal fun Modifier.islandBlur(
     highlightWidth: Dp = AxBlurSurfaceDefaults.HighlightWidth,
 ): Modifier =
     axBlurBackground(
-        enabled = true,
+        // A blur region in the status bar window makes SurfaceFlinger composite the app below
+        // on the GPU every frame while the island shows, which drops frames when scrolling.
+        // Draw the island on its solid fallback instead.
+        enabled = false,
         fallbackColor = fallbackColor,
         tintColor = tint ?: AxBlurSurfaceDefaults.tintColor(),
         cornerRadius = cornerRadius,
-- 
