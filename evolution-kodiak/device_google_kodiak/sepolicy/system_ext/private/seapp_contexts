# Stock's domains for the telephony apps this build ships (see public/apps.te).
#
# GRIL, the RIL extension and modem.pms are re-signed with our platform key
# (not PRESIGNED in proprietary-files.txt), where stock signs them with keys of
# Google's own. So they carry seinfo=platform, and an entry without a seinfo
# would lose to the generic seinfo=platform -> platform_app one: seapp ranks
# seinfo above the package name.
user=_app isPrivApp=true seinfo=platform name=com.google.android.grilservice domain=grilservice_app type=app_data_file levelFrom=all
user=_app isPrivApp=true seinfo=platform name=com.google.android.rilextension domain=rilextensionservice_app levelFrom=all
user=_app isPrivApp=true seinfo=platform name=com.google.android.modem.pms domain=pixel_modem_app type=app_data_file levelFrom=none
user=_app isPrivApp=true seinfo=EuiccSupportPixel name=com.google.euiccpixel domain=euiccpixel_app type=app_data_file levelFrom=all
# Stock matches its ImsStack as the radio user. Ours is built from AOSP and runs
# as an ordinary platform-signed app.
user=_app isPrivApp=true seinfo=platform name=com.android.imsstack domain=imsstack_app type=app_data_file levelFrom=all
# Satellite: Google's NTN service runs as the system user, MediaTek's as an
# ordinary platform-signed priv-app. Both are re-signed with our platform key.
user=system seinfo=platform name=com.google.android.satellite domain=pixelntnservice_app type=app_data_file levelFrom=all
user=_app isPrivApp=true seinfo=platform name=com.mediatek.satellite.service domain=vendor_satellite_service levelFrom=all
