<?xml version="1.0" encoding="iso-8859-1"?>
<!-- EuiccSupportPixel ships with Google's signature (it stays PRESIGNED), so it
     is mapped by certificate. Same cert as the yogi blob (checked 2026-10-11). -->
<policy>
    <signer signature="">
        <seinfo value="EuiccSupportPixel" />
    </signer>
    <!-- PixelSystemService as Evolution's GMS ships it, signed with a Google key
         (CN=Android, 2025-07-10, Java signature hash e0926b9d) that neither the
         platform nor the stock vendor mac_permissions maps. A seinfo of its own,
         so it only selects the seapp entries below. -->
    <signer signature="">
        <seinfo value="pixelsystemservice" />
    </signer>
</policy>
