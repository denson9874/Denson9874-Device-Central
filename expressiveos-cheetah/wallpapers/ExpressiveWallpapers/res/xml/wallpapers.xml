<?xml version="1.0" encoding="utf-8"?>
<!-- ExpressiveOS bespoke wallpaper metadata (listed alongside PixelWallpapers2026 via
     ExpressiveWallpaperPickerActivity; PixelWallpapers2026 keeps Google Photos Memories). -->
