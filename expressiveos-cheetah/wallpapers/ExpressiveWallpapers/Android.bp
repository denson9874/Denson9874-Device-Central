// ExpressiveOS wallpapers for the wallpaper picker (expressiveos-cheetah/wallpapers).
// Registers via ACTION_SET_WALLPAPER so WallpaperPickerGoogleRelease and WallpaperPicker2 list
// "ExpressiveOS" alongside PixelWallpapers2026 without overriding Google's partner wallpaper pack.
android_app {
    name: "ExpressiveWallpapers",
    product_specific: true,
    sdk_version: "current",
    min_sdk_version: "34",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    optimize: {
        enabled: false,
    },
}
