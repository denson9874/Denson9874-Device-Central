<?xml version="1.0" encoding="utf-8"?>
<!-- ExpressiveOS wallpapers: a partner customization APK, resources only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.expressiveos.wallpapers">

    <application
        android:label="@string/app_name"
        android:hasCode="false">
        <!-- The picker finds this APK by this action; the receiver is never called -->
        <receiver
            android:name=".CustomizationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher3.action.PARTNER_CUSTOMIZATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
