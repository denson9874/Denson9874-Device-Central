<?xml version="1.0" encoding="utf-8"?>
<!-- ExpressiveOS wallpapers: registers as an ExpressiveOS category alongside PixelWallpapers2026. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.expressiveos.wallpapers">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:icon="@drawable/ic_expressive_wallpapers"
        android:label="@string/category_expressiveos">
        <activity
            android:name=".ExpressiveWallpaperPickerActivity"
            android:exported="true"
            android:icon="@drawable/ic_expressive_wallpapers"
            android:label="@string/category_expressiveos"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
