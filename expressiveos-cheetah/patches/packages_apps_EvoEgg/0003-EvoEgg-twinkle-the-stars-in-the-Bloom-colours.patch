From 1757bafa0a7bace14d50a228020b0b2fb31e1fd7 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:00:23 +0000
Subject: [PATCH] EvoEgg: twinkle the stars in the Bloom colours

Daryl, 2026-10-27: ExpressiveOS's screens take the Bloom mark's
colours. The egg's 20 background stars were all tinted Evolution X's
electric blue (#005eff) behind the flying ExpressiveOS marks. Tint them
in turn with the mark's four petals instead (violet, blue, green and
coral, the mid tones, which read at half opacity on light and dark
backgrounds).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/org/evolution/easteregg/EasterEgg.java | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/org/evolution/easteregg/EasterEgg.java b/src/org/evolution/easteregg/EasterEgg.java
index 45227fb..c00239e 100644
--- a/src/org/evolution/easteregg/EasterEgg.java
+++ b/src/org/evolution/easteregg/EasterEgg.java
@@ -29,7 +29,6 @@ import android.content.Intent;
 import android.graphics.drawable.AnimationDrawable;
 import android.graphics.Bitmap;
 import android.graphics.Canvas;
-import android.graphics.Color;
 import android.graphics.Matrix;
 import android.graphics.Paint;
 import android.graphics.Point;
@@ -57,6 +56,9 @@ public class EasterEgg extends Activity {
     public static class Board extends FrameLayout {
         public static final boolean FIXED_STARS = true;
         public static final int NUM_CATS = 20;
+        // The Bloom mark's petals (violet, blue, green, coral), mid tones, so the
+        // half-transparent stars read on light and dark backgrounds alike
+        static final int[] STAR_COLORS = { 0xFFAE69FC, 0xFF417BFC, 0xFF4AD29D, 0xFFFD7771 };
 
         static Random sRNG = new Random();
 
@@ -124,7 +126,7 @@ public class EasterEgg extends Activity {
                     ImageView fixedStar = new ImageView(getContext(), null);
                     if (DEBUG) fixedStar.setBackgroundColor(0x8000FF80);
                     fixedStar.setImageResource(R.drawable.star_anim); // @@@
-                    fixedStar.setColorFilter(Color.parseColor("#005eff"));
+                    fixedStar.setColorFilter(STAR_COLORS[i % STAR_COLORS.length]);
                     fixedStar.setAlpha(0.5F);
                     addView(fixedStar, wrap);
                     final float scale = randfrange(0.1f, 1f);
-- 
2.43.0

