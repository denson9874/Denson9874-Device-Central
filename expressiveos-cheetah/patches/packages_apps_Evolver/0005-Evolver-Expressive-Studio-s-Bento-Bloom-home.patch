+
+@Composable
+private fun ClockStylesCard(onClick: () -> Unit) {
+    val resumes = rememberResumeCount()
+    val style = rememberClockStyle(resumes)
+    WideCard(
+        title = stringResource(R.string.ls_clock_title),
