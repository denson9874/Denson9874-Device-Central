+        onClick = onClick,
+        modifier = Modifier
+            .fillMaxWidth()
+            .heightIn(min = 96.dp),
+    ) {
+        // Centred in the card when the text is shorter than its least height
+        Row(
+            modifier = Modifier
+                .align(Alignment.CenterStart)
+                .padding(start = 20.dp, top = 12.dp, end = 16.dp, bottom = 12.dp),
+            verticalAlignment = Alignment.CenterVertically,
