+                        size = 40.dp,
+                        step = minOf(28.dp, (maxWidth - 40.dp) / (petals.size - 1))
+                            .coerceAtLeast(0.dp),
+                        ring = MaterialTheme.colorScheme.surfaceBright,
+                    )
+                }
