-                    ) {
-                        if (githubUrl != null) {
-                            LinkButton(
-                                label   = stringResource(R.string.maintainer_link_github),
-                                iconRes = R.drawable.ic_github_2,
-                                onClick = { onOpenUrl(githubUrl) },
