From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <daryldenson0405@gmail.com>
Date: Sun, 1 Nov 2026 22:31:28 +0100
Subject: [PATCH] gs201: resolve gxp_logging, hwc, and bluetooth SELinux
 denials

- Connect gxp_logging to Perfetto producer with perfetto_producer(gxp_logging),
  eliminating traced_producer_socket write denials every 30s.
- Allow hal_graphics_composer_default to search/read vendor_log_file:dir,
  resolving PrimaryDisplay_hwc_error_log0.txt permission denied.
- Allow hal_bluetooth_btlinux read permissions on logbuffer_device chr_file.
---
 sepolicy/vendor/bluetooth.te                     | 2 ++
 sepolicy/vendor/gxp_logging.te                   | 2 ++
 sepolicy/vendor/hal_graphics_composer_default.te | 1 +
 3 files changed, 5 insertions(+)

diff --git a/sepolicy/vendor/bluetooth.te b/sepolicy/vendor/bluetooth.te
index 86bc61d8..3ee6449d 100644
--- a/sepolicy/vendor/bluetooth.te
+++ b/sepolicy/vendor/bluetooth.te
@@ -1,4 +1,6 @@
 allow bluetooth proc_vendor_sched:dir r_dir_perms;
 allow bluetooth proc_vendor_sched:file w_file_perms;
 
+allow hal_bluetooth_btlinux logbuffer_device:chr_file r_file_perms;
+
 dontaudit bluetooth default_android_service:service_manager find;
diff --git a/sepolicy/vendor/gxp_logging.te b/sepolicy/vendor/gxp_logging.te
index 9554f396..384a7cbe 100644
--- a/sepolicy/vendor/gxp_logging.te
+++ b/sepolicy/vendor/gxp_logging.te
@@ -14,3 +14,5 @@ allow gxp_logging fwk_stats_service:service_manager find;
 allow gxp_logging gxp_device:chr_file rw_file_perms;
 allow gxp_logging sysfs_gxp:dir search;
 allow gxp_logging sysfs_gxp:file rw_file_perms;
+
+perfetto_producer(gxp_logging)
diff --git a/sepolicy/vendor/hal_graphics_composer_default.te b/sepolicy/vendor/hal_graphics_composer_default.te
index 3f615f84..77f8802c 100644
--- a/sepolicy/vendor/hal_graphics_composer_default.te
+++ b/sepolicy/vendor/hal_graphics_composer_default.te
@@ -32,3 +32,4 @@ allow hal_graphics_composer_default sysfs_leds:dir r_dir_perms;
 allow hal_graphics_composer_default sysfs_leds:file rw_file_perms;
 allow hal_graphics_composer_default vendor_hwc_log_file:dir rw_dir_perms;
 allow hal_graphics_composer_default vendor_hwc_log_file:file create_file_perms;
+allow hal_graphics_composer_default vendor_log_file:dir r_dir_perms;
-- 
2.43.0
