-                clipboard.setPrimaryClip(ClipData.newPlainText("Log URL", url));
+    private void copyCrashLog() {
+        if (mPaste == null) {
+            return;
+        }
+        final String log = mPaste.length() > MAX_COPY_LENGTH
+                ? mPaste.substring(0, MAX_COPY_LENGTH) : mPaste;
 
