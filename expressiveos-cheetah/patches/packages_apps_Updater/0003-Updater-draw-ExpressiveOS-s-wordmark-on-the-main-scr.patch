From b855b834b5737c5c75238248248c8589aa29ac64 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:42:10 +0000
Subject: [PATCH] Updater: draw ExpressiveOS's wordmark on the main screen

ExpressiveOS is its own ROM: the logo above the update status and in
the top bar was Evolution X's wordmark. Draw the ExpressiveOS wordmark
instead, the same paths as the Settings banner, with each glyph's
overlapping contours merged so the outline has no inner lines.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../evolution/updater/ui/EvolutionLogoGlow.kt |  2 +-
 .../main/res/values/evolution_logo_paths.xml  | 26 +++++++++----------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/app/src/main/java/org/evolution/updater/ui/EvolutionLogoGlow.kt b/app/src/main/java/org/evolution/updater/ui/EvolutionLogoGlow.kt
index e252e1f..dd39c6d 100644
--- a/app/src/main/java/org/evolution/updater/ui/EvolutionLogoGlow.kt
+++ b/app/src/main/java/org/evolution/updater/ui/EvolutionLogoGlow.kt
@@ -81,7 +81,7 @@ private val SPARKLES = arrayOf(
 )
 
 /**
- * The Evolution X wordmark with a holographic treatment: a pink, violet and
+ * The ExpressiveOS wordmark with a holographic treatment: a pink, violet and
  * cyan gradient sweeping across the outline, a soft neon glow with a chromatic
  * fringe, a periodic shine streak and a few twinkling sparkles. Shine and
  * sparkles follow the theme's on-surface color. Mirrors GlowView in Settings.
diff --git a/app/src/main/res/values/evolution_logo_paths.xml b/app/src/main/res/values/evolution_logo_paths.xml
index 69dfad1..beebc68 100644
--- a/app/src/main/res/values/evolution_logo_paths.xml
+++ b/app/src/main/res/values/evolution_logo_paths.xml
@@ -4,20 +4,20 @@
      SPDX-License-Identifier: Apache-2.0
 -->
 <resources>
-    <!-- Outline path data of the Evolution X wordmark. Same geometry as
+    <!-- Outline path data of the ExpressiveOS wordmark. Same geometry as
          ic_evolution_logo_outline, used by EvolutionLogoGlow to draw the holographic logo. -->
     <string-array name="evolution_logo_paths" translatable="false">
