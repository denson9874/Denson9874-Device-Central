From a62a181f87d4be400b4ae8c91e6cc36dbe2f62d4 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:41:36 +0000
Subject: [PATCH] Updater: default to ExpressiveOS's OTA feed and changelogs

ExpressiveOS is its own ROM: the device overlay already points the
updater at ExpressiveOS's OTA repo, but the APK's own defaults still
named Evolution X's feed. Default to the builds JSON and changelogs on
denson9874/expressiveos_ota main, so a build without the overlay never
contacts Evolution X's OTA repo either.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 app/src/main/res/values/strings.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/src/main/res/values/strings.xml b/app/src/main/res/values/strings.xml
index 98075c8..d96c3a2 100644
--- a/app/src/main/res/values/strings.xml
+++ b/app/src/main/res/values/strings.xml
@@ -22,7 +22,7 @@
         Optional placeholders replaced at runtime:
           {device} - Device name
     -->
-    <string name="updater_server_url" translatable="false">https://raw.githubusercontent.com/Evolution-X/OTA/cnb/builds/{device}.json</string>
+    <string name="updater_server_url" translatable="false">https://raw.githubusercontent.com/denson9874/expressiveos_ota/main/builds/{device}.json</string>
 
     <string name="verification_failed_notification">Verification failed</string>
     <string name="verifying_download_notification">Verifying update</string>
@@ -113,7 +113,7 @@
     <string name="menu_stream_updates_summary">Install updates while downloading. Disable to save update packages for export.</string>
     <string name="menu_delete_update">Delete</string>
     <string name="menu_export_update">Export update</string>
-    <string name="menu_changelog_url" translatable="false">https://raw.githubusercontent.com/Evolution-X/OTA/cnb/changelogs/<xliff:g id="device_name">%1$s</xliff:g>.txt</string>
+    <string name="menu_changelog_url" translatable="false">https://raw.githubusercontent.com/denson9874/expressiveos_ota/main/changelogs/<xliff:g id="device_name">%1$s</xliff:g>.txt</string>
     <string name="menu_view_downloads">View on <xliff:g id="brand_name" example="LineageOS">%1$s</xliff:g> Downloads</string>
     <string name="menu_metered_network_warning">Metered network warning</string>
     <string name="menu_metered_network_warning_summary">Warn before downloading over mobile data</string>
-- 
2.43.0

