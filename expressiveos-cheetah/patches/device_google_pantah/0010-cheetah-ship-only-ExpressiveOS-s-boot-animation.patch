From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH 10/10] cheetah: ship only ExpressiveOS's boot animation

ExpressiveOS has its own boot animation. Leave out Evolution X's other
styles, which would otherwise take about 190 MiB of /product and let
users switch away from it.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 lineage_cheetah.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/lineage_cheetah.mk b/lineage_cheetah.mk
index b6c20c3..159d6c1 100644
--- a/lineage_cheetah.mk
+++ b/lineage_cheetah.mk
@@ -22,6 +22,11 @@ PRODUCT_SYSTEM_NAME := generic_system_google
 # Boot animation
 TARGET_SCREEN_HEIGHT := 3120
 TARGET_SCREEN_WIDTH := 1440
+# Only ExpressiveOS's own animation (vendor/extra/bootanimation), not Evolution X's
+# other styles (about 190 MiB in /product/media). Product config reads this file
+# before the ones it inherits, so this wins over vendor/lineage's common.mk default
+# (?= true) for every build of this tree.
+TARGET_INCLUDE_BOOT_ANIMATIONS := false
 
 # Custom flags
 TARGET_HAS_UDFPS := true
-- 
