+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.content;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.UserIdInt;
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.content.pm.SigningDetails;
+import android.os.Bundle;
+import android.text.TextUtils;
+
+import com.android.server.pm.pkg.AndroidPackage;
+
+/**
+ * Helpers for microG signature spoofing.
+ *
+ * @hide
+ */
+public final class MicrogUtils {
+    public static final String COMPANION_PACKAGE_NAME = "com.android.vending";
+    public static final String SERVICES_PACKAGE_NAME = "com.google.android.gms";
+
+    public static final Signature FAKE_SIGNATURE = new Signature("");
+    public static final Signature REAL_SIGNATURE = new Signature("");
+
+    private static final String FAKE_SIGNATURE_METADATA = "fake-signature";
+
+    private MicrogUtils() {}
+
+    public static native boolean isDebuggable();
+
+    private static boolean isMicrogPackageName(@Nullable String packageName) {
+        return COMPANION_PACKAGE_NAME.equals(packageName)
+                || SERVICES_PACKAGE_NAME.equals(packageName);
+    }
+
+    /**
+     * Whether the package may use microG signature spoofing. ExpressiveOS, as its 1.0 did, allows
+     * it on every build, not only debuggable ones, for microG's two packages and for ReVanced's
+     * microG (a package name with "revanced" in it), whatever key they're signed with. The
+     * fake-signature metadata must still ask for {@link #FAKE_SIGNATURE}.
+     */
+    public static boolean isMicrogSigned(@NonNull AndroidPackage pkg) {
+        String packageName = pkg.getPackageName();
+        return isMicrogPackageName(packageName)
+                || (packageName != null && packageName.toLowerCase().contains("revanced"));
+    }
+
+    /**
+     * Returns the signature requested via the package's fake-signature metadata, or null if the
+     * package isn't microG signed or the requested signature isn't {@link #FAKE_SIGNATURE}.
+     */
+    @Nullable
+    public static Signature getFakeSignature(@NonNull AndroidPackage pkg) {
+        if (!isMicrogSigned(pkg)) {
+            return null;
+        }
+        Bundle metadata = pkg.getMetaData();
+        if (metadata == null) {
+            return null;
+        }
+        String fakeSignatureStr = metadata.getString(FAKE_SIGNATURE_METADATA);
+        if (TextUtils.isEmpty(fakeSignatureStr)) {
+            return null;
+        }
+        Signature fakeSignature = new Signature(fakeSignatureStr);
+        return FAKE_SIGNATURE.equals(fakeSignature) ? fakeSignature : null;
+    }
+
+    /**
+     * Whether the package is microG Services (or genuine GmsCore) as reported by PackageManager,
+     * which only reports {@link #FAKE_SIGNATURE} after validating the fake-signature metadata.
+     */
+    public static boolean isMicrogServices(@NonNull Context context, @Nullable String packageName,
+            @UserIdInt int userId) {
+        if (!SERVICES_PACKAGE_NAME.equals(packageName)) {
+            return false;
+        }
+        try {
+            PackageInfo packageInfo = context.getPackageManager().getPackageInfoAsUser(
+                    packageName,
+                    PackageManager.GET_META_DATA | PackageManager.GET_SIGNING_CERTIFICATES,
+                    userId);
+            return packageInfo != null && packageInfo.signingInfo != null
+                    && Signature.areExactMatch(packageInfo.signingInfo.getSigningDetails(),
+                            new Signature[]{FAKE_SIGNATURE});
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+}
