From caa1a1f8571c18e38ac3bcd5740ef2ed5e236b86 Mon Sep 17 00:00:00 2001
From: Daryl Denson <daryldenson0405@gmail.com>
Date: Sat, 31 Oct 2026 21:06:02 -0400
Subject: [PATCH] cheetah: preinstall the KernelSU Next manager only with a
 KernelSU init_boot

ExpressiveOS ships unrooted; root is the user's choice (Daryl,
2026-11-01). The kit builds cheetah with EOS_KSU=none, whose check
refuses a build that still installs the manager. Tie the manager to
CHEETAH_KSU_INIT_BOOT, which the kit sets only when it ships KernelSU
Next, so EOS_KSU=lkm still gets it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 device-cheetah.mk | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/device-cheetah.mk b/device-cheetah.mk
index c5386e7..4d61d19 100644
--- a/device-cheetah.mk
+++ b/device-cheetah.mk
@@ -101,6 +101,10 @@ PRODUCT_PACKAGES += \
 # KernelSU Next manager, byte for byte as upstream signed it, with its arm64 libs
 # (vendor/extra/ksu, which ExpressiveOS's expressiveos-cheetah/ksu/apply-ksu.sh
 # stages). A normal, unprivileged app: no app gets root until the user grants it
-# there.
+# there. Only with a KernelSU Next init_boot (CHEETAH_KSU_INIT_BOOT, set by the
+# kit when devices/cheetah.conf has EOS_KSU=lkm): ExpressiveOS ships unrooted, and
+# root is the user's choice.
+ifneq ($(CHEETAH_KSU_INIT_BOOT),)
 PRODUCT_PACKAGES += \
     KernelSUNext
+endif
-- 
