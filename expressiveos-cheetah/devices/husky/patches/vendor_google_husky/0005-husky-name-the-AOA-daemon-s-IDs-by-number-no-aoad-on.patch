From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Sat, 24 Oct 2026 15:13:40 +0200
Subject: [PATCH 5/5] husky: name the AOA daemon's IDs by number (no aoad on
 this platform)

CP3A's USB gadget HAL runs in group aoad and init.zuma.usb.rc makes the
userspace AOA FunctionFS directories owned by aoad: the AID (1103) of the
userspace Android Open Accessory daemon that Android 17 QPR stock adds.
This platform has neither the AID nor aoad, so host_init_verifier stopped
the build ("Unable to decode GID for 'aoad'"). Use the number, which is
what stock resolves the name to (the rc already mounts the FunctionFS with
uid/gid 1103). shusky keeps userspace AOA off, so accessory mode stays in
the kernel's accessory function, as through CP2A.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../vendor/etc/init/android.hardware.usb.gadget-service.rc    | 2 +-
 proprietary/vendor/etc/init/hw/init.zuma.usb.rc               | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/proprietary/vendor/etc/init/android.hardware.usb.gadget-service.rc b/proprietary/vendor/etc/init/android.hardware.usb.gadget-service.rc
index f27196b8..a82cc2b6 100644
--- a/proprietary/vendor/etc/init/android.hardware.usb.gadget-service.rc
+++ b/proprietary/vendor/etc/init/android.hardware.usb.gadget-service.rc
@@ -1,7 +1,7 @@
 service vendor.usb-gadget-hal /vendor/bin/hw/android.hardware.usb.gadget-service
     class hal
     user system
-    group system shell mtp aoad
+    group system shell mtp 1103
 
 on post-fs
     chown root system /sys/class/typec/port0/power_role
diff --git a/proprietary/vendor/etc/init/hw/init.zuma.usb.rc b/proprietary/vendor/etc/init/hw/init.zuma.usb.rc
index b3120a03..3d5901be 100644
--- a/proprietary/vendor/etc/init/hw/init.zuma.usb.rc
+++ b/proprietary/vendor/etc/init/hw/init.zuma.usb.rc
@@ -29,8 +29,8 @@ on early-boot
     mkdir /dev/usb-ffs/adb 0770 shell shell
     mkdir /dev/usb-ffs/mtp 0770 mtp mtp
     mkdir /dev/usb-ffs/ptp 0770 mtp mtp
-    mkdir /dev/usb-ffs/ctrl 0770 aoad aoad
-    mkdir /dev/usb-ffs/aoa 0770 aoad aoad
+    mkdir /dev/usb-ffs/ctrl 0770 1103 1103
+    mkdir /dev/usb-ffs/aoa 0770 1103 1103
     mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1
     mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
     mount functionfs ptp /dev/usb-ffs/ptp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
-- 
