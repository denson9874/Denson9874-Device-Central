From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:00:00 +0000
Subject: [PATCH 02/11] husky: set ExpressiveOS's maintainer

ExpressiveOS's Settings names the build's maintainer on the Android
version screen (Settings > About). LineageOS's husky tree has no
maintainer string, so Settings would show none. Add an ExpressiveOS
Settings overlay (overlay-expressiveos, in DEVICE_PACKAGE_OVERLAYS)
naming ExpressiveOS's maintainer, in expressiveos_strings.xml.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lineage_husky.mk                                         | 3 +++
 .../apps/Settings/res/values/expressiveos_strings.xml    | 9 +++++++++
 2 files changed, 12 insertions(+)
 create mode 100644 overlay-expressiveos/packages/apps/Settings/res/values/expressiveos_strings.xml

diff --git a/lineage_husky.mk b/lineage_husky.mk
index b660faa..32f3a4b 100644
--- a/lineage_husky.mk
+++ b/lineage_husky.mk
@@ -19,6 +19,9 @@ PRODUCT_SYSTEM_BRAND := google
 PRODUCT_SYSTEM_MANUFACTURER := Google
 PRODUCT_SYSTEM_NAME := generic_system_google
 
+# ExpressiveOS overlays
+DEVICE_PACKAGE_OVERLAYS += $(DEVICE_PATH)/overlay-expressiveos
+
 # Boot animation
 TARGET_SCREEN_HEIGHT := 2992
 TARGET_SCREEN_WIDTH := 1344
diff --git a/overlay-expressiveos/packages/apps/Settings/res/values/expressiveos_strings.xml b/overlay-expressiveos/packages/apps/Settings/res/values/expressiveos_strings.xml
new file mode 100644
index 0000000..9934f3d
--- /dev/null
+++ b/overlay-expressiveos/packages/apps/Settings/res/values/expressiveos_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2026 ExpressiveOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Android version screen, build maintainer -->
+    <string name="build_maintainer_summary" translatable="false">Daryl Denson</string>
+</resources>
-- 
