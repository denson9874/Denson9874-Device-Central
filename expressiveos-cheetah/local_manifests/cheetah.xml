<?xml version="1.0" encoding="UTF-8"?>
<!-- Pixel 7 Pro (cheetah) for ExpressiveOS: Evolution X's own cnb device trees and blobs
     (Evolution-X-Devices), plus LineageOS's pantah kernel module lists. The kernel itself is
     built with build_kernel. The same projects as evolution-cheetah/local_manifests/cheetah.xml,
     pinned like pins/manifest.xml: each at the commit the build server's tree had for the 1.0
     builds of 2026-10-26 and 2026-10-27, never at a branch head (Evolution X rewrites cnb).
     ExpressiveOS's changes are local commits (apply.sh). -->
<manifest>
  <remote name="evox-devices" fetch="https://github.com/Evolution-X-Devices" revision="cnb" />
  <remote name="lineage-pantah" fetch="https://github.com/LineageOS" revision="lineage-24.0" />

  <project path="device/google/pantah" name="device_google_pantah" remote="evox-devices"
           revision="9e2cc13d829e5ce327a2d5df866c92a14aa45395" upstream="cnb" />
  <project path="device/google/gs201" name="device_google_gs201" remote="evox-devices"
           revision="d8463ba4c24b0b8f79082387326bfcfc1a61081a" upstream="cnb" />
  <project path="device/google/pantah-kernels" name="android_device_google_pantah-kernels" remote="lineage-pantah"
           revision="e0bcfb04231e9c0d3df942604218dfc8dbed2011" upstream="lineage-24.0" />
  <!-- Blobs and firmware; radio/ and a few large APKs are Git LFS objects (gitlab.com) -->
  <project path="vendor/google/cheetah" name="vendor_google_cheetah" remote="evox-devices" clone-depth="1"
           revision="4ff00fde236bd5c39fd70982daa4f766170a3ea5" upstream="cnb" />
</manifest>
