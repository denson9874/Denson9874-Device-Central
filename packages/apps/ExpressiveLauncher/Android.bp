// ==============================================================================
// ExpressiveOS System Launcher Build Blueprint (Android 17 / API 37)
// Privileged Platform Quickstep & Overview Provider for Pixel 11 Pro / XL
// ==============================================================================

package {
    default_applicable_licenses: ["packages_apps_ExpressiveLauncher_license"],
}

license {
    name: "packages_apps_ExpressiveLauncher_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE.txt"],
}

android_library {
    name: "ExpressiveLauncher-core",
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
        "lawnchair/src/**/*.kt",
        "lawnchair/src/**/*.java",
    ],
    resource_dirs: [
        "res",
        "lawnchair/res",
    ],
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.recyclerview_recyclerview",
        "androidx.dynamicanimation_dynamicanimation",
        "androidx.preference_preference",
        "androidx.palette_palette",
        "androidx.room_room-runtime",
        "androidx.compose.runtime_runtime",
        "androidx.compose.material3_material3",
        "androidx.compose.foundation_foundation",
        "androidx.compose.ui_ui",
        "kotlinx_coroutines_android",
    ],
    manifest: "AndroidManifest-common.xml",
    platform_apis: true,
}

android_app {
    name: "ExpressiveLauncherQuickstep",
    static_libs: [
        "ExpressiveLauncher-core",
        "SystemUISharedLib",
        "WindowManager-Shell",
        "SystemUI-statsd",
    ],
    srcs: [
        "quickstep/src/**/*.kt",
        "quickstep/src/**/*.java",
    ],
    resource_dirs: [
        "quickstep/res",
    ],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    
    // Replace default AOSP / Google launchers
    overrides: [
        "Launcher3",
        "Launcher3QuickStep",
        "NexusLauncherRelease",
        "PixelLauncher",
    ],

    required: [
        "privileged-permissions-expressive",
        "sysconfig-expressive",
    ],

    optimize: {
        shrink: true,
        proguard_flags_files: ["proguard.flags", "proguard.pro"],
    },
}

prebuilt_etc {
    name: "privileged-permissions-expressive",
    sub_dir: "permissions",
    src: "privileged-permissions-expressive.xml",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sysconfig-expressive",
    sub_dir: "sysconfig",
    src: "sysconfig-expressive.xml",
    system_ext_specific: true,
}
