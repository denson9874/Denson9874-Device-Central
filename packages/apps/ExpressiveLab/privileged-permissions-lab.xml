<?xml version="1.0" encoding="utf-8"?>
<!--
    ExpressiveOS: Privileged Permissions Whitelist for Expressive Lab
    Enables direct system configuration toggles, secure settings manipulation,
    and RRO overlay package management.
-->
<permissions>
    <privapp-permissions package="dev.expressive.os.lab">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
        <permission name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    </privapp-permissions>
</permissions>
