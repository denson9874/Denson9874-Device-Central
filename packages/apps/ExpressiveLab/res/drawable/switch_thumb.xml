<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/switch_thumb_on" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
            <item
                android:width="14dp"
                android:height="14dp"
                android:gravity="center"
                android:drawable="@drawable/ic_switch_check" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/switch_thumb_off" />
                    <size android:width="20dp" android:height="20dp" />
                </shape>
            </item>
            <item
                android:width="10dp"
                android:height="10dp"
                android:gravity="center"
                android:drawable="@drawable/ic_switch_close" />
        </layer-list>
    </item>
</selector>
