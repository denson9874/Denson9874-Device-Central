From 189ac3b3dbb41fc0f0b897a998b3bcfbcbdf8626 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Sat, 17 Oct 2026 20:28:54 +0000
Subject: [PATCH 1/2] cheetah: set unofficial maintainer

These Android 17 builds are unofficial: the Settings > About maintainer line
names Daryl Denson (Unofficial) instead of the official Android 16
maintainer, whose name the tree carries for official builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../res/values/evolution_strings.xml                          | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/cheetah/overlay/SettingsGoogleCheetahOverlay/res/values/evolution_strings.xml b/cheetah/overlay/SettingsGoogleCheetahOverlay/res/values/evolution_strings.xml
index 444a3c4..ac7a346 100644
--- a/cheetah/overlay/SettingsGoogleCheetahOverlay/res/values/evolution_strings.xml
+++ b/cheetah/overlay/SettingsGoogleCheetahOverlay/res/values/evolution_strings.xml
@@ -5,6 +5,6 @@
 -->
 <resources>
     <!-- Android version screen, build maintainer -->
-    <string name="build_maintainer_summary" translatable="false">nhansp</string>
-    <string name="build_maintainer_donate_url" translatable="false">https://github.com/nhansp</string>
+    <string name="build_maintainer_summary" translatable="false">Daryl Denson (Unofficial)</string>
+    <string name="build_maintainer_donate_url" translatable="false">https://github.com/denson9874</string>
 </resources>
-- 
2.43.0

