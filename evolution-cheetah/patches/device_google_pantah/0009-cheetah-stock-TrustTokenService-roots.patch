-<!-- Generated by tools/rro2xml.py from the stock cheetah CP3A.261005.002.A1 overlays: framework-res__cheetah__auto_generated_rro_vendor.apk, PixelConfigOverlayCommon.apk. -->
+<!-- Generated by tools/rro2xml.py from the stock cheetah CP3A.261005.002.A1 overlays: framework-res__cheetah__auto_generated_rro_vendor.apk, PixelConfigOverlayCommon.apk, GoogleConfigOverlay.apk. -->
 <resources>
     <bool name="config_pinnerCameraApp">true</bool>
     <bool name="config_update_operator_name_after_carrier_config_loaded">true</bool>
+    <integer name="vendor_required_trust_token_roots_timestamp">1779874873</integer>
