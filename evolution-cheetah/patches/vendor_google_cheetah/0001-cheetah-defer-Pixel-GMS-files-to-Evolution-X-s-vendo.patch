From a992340b5f3b7db87b113be778b2d365f5d30281 Mon Sep 17 00:00:00 2001
From: Daryl Denson <9751141+denson9874@users.noreply.github.com>
Date: Sun, 18 Oct 2026 00:19:54 +0200
Subject: [PATCH] cheetah: defer Pixel GMS files to Evolution X's vendor/gms

Evolution X's vendor/gms installs DeviceIntelligenceNetworkPrebuiltAstrea
(versionCode 137423, ours is 127331) and 14 Pixel sysconfig and
default-permission XMLs (byte-identical to ours) as modules; the same
names and paths cannot also come from here. Kati stopped with
"MODULE.TARGET.APPS.DeviceIntelligenceNetworkPrebuiltAstrea already
defined by vendor/google/cheetah". Same as husky's vendor 0001.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Android.bp        | 13 -------------
 cheetah-vendor.mk | 15 ---------------
 2 files changed, 28 deletions(-)

diff --git a/Android.bp b/Android.bp
index bf49299..27a5128 100644
--- a/Android.bp
+++ b/Android.bp
@@ -315,19 +315,6 @@ android_app_import {
     product_specific: true,
 }
 
-android_app_import {
-    name: "DeviceIntelligenceNetworkPrebuiltAstrea",
-    owner: "google",
-    apk: "proprietary/product/priv-app/DeviceIntelligenceNetworkPrebuiltAstrea/DeviceIntelligenceNetworkPrebuiltAstrea.apk",
-    preprocessed: true,
-    presigned: true,
-    dex_preopt: {
-        enabled: false,
-    },
-    privileged: true,
-    product_specific: true,
-}
-
 android_app_import {
     name: "DevicePersonalizationAiAiPrebuiltPixel2022",
     owner: "google",
diff --git a/cheetah-vendor.mk b/cheetah-vendor.mk
index a2f54b4..78ace83 100644
