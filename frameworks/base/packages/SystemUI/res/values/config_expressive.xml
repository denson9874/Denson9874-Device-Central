<?xml version="1.0" encoding="utf-8"?>
<!--
    ExpressiveOS: SystemUI Configuration Overlays
-->
<resources>
    <!-- Quick Settings Layout: Expressive 2x4 Large Pill Grid -->
    <integer name="quick_settings_num_columns">2</integer>
    <integer name="quick_settings_max_rows">4</integer>

    <!-- Enable real-time wallpaper blur scrim in notification shade -->
    <bool name="config_windowBlursSupported">true</bool>
    <dimen name="scrim_behind_blur_radius">48dp</dimen>

    <!-- Lockscreen Hybrid Smartspace & Clock -->
    <bool name="config_smartspace_expressive_sync_enabled">true</bool>
    <dimen name="keyguard_clock_top_margin">64dp</dimen>
</resources>
